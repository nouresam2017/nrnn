import numpy as np
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.utils import to_categorical
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, SimpleRNN, Dense


text = "I love deep learning"
words = text.lower().split()


tokenizer = Tokenizer()
tokenizer.fit_on_texts([text])
sequences = tokenizer.texts_to_sequences([text])[0]


X = np.array(sequences[:3])  # "I", "love", "deep"
y = to_categorical([sequences[3]-1], num_classes=len(tokenizer.word_index))


X = X.reshape((1, 3, 1))


model = Sequential()
model.add(SimpleRNN(10, input_shape=(3, 1)))
model.add(Dense(len(tokenizer.word_index), activation='softmax'))


model.compile(loss='categorical_crossentropy', optimizer='adam', metrics=['accuracy'])
model.fit(X, y, epochs=500, verbose=0)


predicted = model.predict(X)
predicted_word_index = np.argmax(predicted) + 1
predicted_word = tokenizer.index_word[predicted_word_index]

print(f"Predicted 4th word: {predicted_word}")
